# Fill privately on Debian; chmod 600 .env. Never commit a real .env.
APP_ENV=production
POSTGRES_DB=rrhh_sipe
POSTGRES_USER=rrhh
# Generate privately: openssl rand -hex 32. Hex avoids URI interpolation ambiguity.
POSTGRES_PASSWORD=
RRHH_API_PORT=8300
LOCAL_TIMEZONE=America/La_Paz
CORS_ALLOW_ORIGINS=
CORRESPONDENCIA_API_URL=
# QA only: APP_ENV=qa + this flag allow exactly http://backend:8000.
# Production always requires HTTPS, e.g. https://api-correspondencia.sipesipe.gob.bo.
ALLOW_PRIVATE_HTTP_CORRESPONDENCIA=false
CORRESPONDENCIA_API_TOKEN=
CORRESPONDENCIA_API_TIMEOUT=30
CORRESPONDENCIA_REFRESH_COOKIE_NAME=refresh_token
SESSION_COOKIE_NAME=rrhh_refresh_token
# API published at domain root; if a proxy later adds /api, change to /api/auth.
SESSION_COOKIE_PATH=/auth
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
BIOMETRIC_API_URL=https://biometric.sipesipe.gob.bo
BIOMETRIC_API_TOKEN=
BIOMETRIC_API_TIMEOUT=60
BIOMETRIC_DEVICE_ID=alcaldia-central
# Keep disabled until the former synchronizer is stopped under an approved cutover.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=900
WORKER_POLL_SECONDS=5
