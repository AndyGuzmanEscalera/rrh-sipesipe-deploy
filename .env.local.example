# Development-only Docker Compose configuration. Copy to .env.local; never commit it.
RUNTIME_ENV_FILE=.env.local
APP_ENV=development
POSTGRES_DB=rrhh
POSTGRES_USER=rrhh
POSTGRES_PASSWORD=rrhh_local
RRHH_API_PORT=8300
LOCAL_TIMEZONE=America/La_Paz
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORRESPONDENCIA_API_URL=http://host.docker.internal:8000
ALLOW_PRIVATE_HTTP_CORRESPONDENCIA=true
CORRESPONDENCIA_API_TOKEN=
CORRESPONDENCIA_API_TIMEOUT=30
CORRESPONDENCIA_REFRESH_COOKIE_NAME=refresh_token
SESSION_COOKIE_NAME=rrhh_refresh_token
SESSION_COOKIE_PATH=/auth
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# No token real is needed unless a local biometric synchronization is explicitly queued.
BIOMETRIC_API_URL=https://biometric.sipesipe.gob.bo
BIOMETRIC_API_TOKEN=development-only-not-a-real-token
BIOMETRIC_API_TIMEOUT=60
BIOMETRIC_DEVICE_ID=alcaldia-central
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=900
WORKER_POLL_SECONDS=5
